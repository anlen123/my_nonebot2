# Honcho 配置示例 —— 面向「给本插件当长期记忆后端」这一个用途
#
# 变量名取自 Honcho 仓库的 .env.template(嵌套用 __ 分隔)。这里只列与本用途相关的,
# 完整清单以你 checkout 里的 .env.template 为准。
#
#     cp .env.example .env   # 然后填 key
#
# 起步策略:所有 LLM 模块指向便宜的 flash 档模型,embedding 单独配一家能用的,先把链路跑通。

# =============================================================================
# 基础
# =============================================================================
LOG_LEVEL=INFO

# docker compose 会用它拼数据库口令,请改掉
POSTGRES_PASSWORD=change-me

# 注意:compose 文件里已显式覆盖 DB_CONNECTION_URI / CACHE_URL 指向服务名,
# 这里写不写都不生效。脱离 docker 直接跑时才需要它:
# DB_CONNECTION_URI=postgresql+psycopg://postgres:change-me@localhost:5432/postgres

# 端口只绑 127.0.0.1 时可以关鉴权。一旦要跨机访问(Hermes 不在同一台),
# 必须打开鉴权并配反向代理 + TLS,否则任何能连到端口的人都能读写全部记忆。
AUTH_USE_AUTH=false

# =============================================================================
# LLM —— deriver / dialectic / summary / dream
# =============================================================================
# Honcho 只发文本(消息内容在库里是一列 TEXT),不需要多模态模型。干的活儿是
# 「读一段对话 → 提炼事实/画像/摘要」,flash / mini 档足够。
#
# 全局出口:所有 transport=openai 的模块共用下面这一对(src/llm/registry.py)。
# 各模块只在需要走**别的**网关时才单独覆盖 OVERRIDES__BASE_URL。
# 模型 id 照你的网关实际返回的名字填(GET <base_url>/models)。
#
# 改完要 `docker compose up -d` 重建容器,restart 不重读 env_file。

LLM_OPENAI_API_KEY=sk-your-key-here
LLM_OPENAI_BASE_URL=https://your-gateway.example/v1

# ---- deriver:每条消息触发一次,是额度消耗的大头 ----
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=your-flash-model-id
# 想让这个模块用另一把 key 时,填一个环境变量名(不是 key 本身):
# DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY

# 小机器保持单 worker;并发上去只会更快烧额度,不会让记忆更准
DERIVER_WORKERS=1
DERIVER_MODEL_CONFIG__THINKING_EFFORT=minimal
DERIVER_MODEL_CONFIG__MAX_OUTPUT_TOKENS=2048

# ---- dialectic:按轮次触发,一轮可能打好几发 ----
# 五个档位可以全指到同一个 flash 模型;真正省钱的旋钮是调用频次与档位选择。
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=your-flash-model-id
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=your-flash-model-id
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=your-flash-model-id
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=your-flash-model-id
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=your-flash-model-id

# ---- summary:会话推进到一定长度时跑一次 ----
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=your-flash-model-id

# ---- dream:后台"睡眠期整理",默认开着 ----
# 攒够一批观察后派两个自主 agent 回头重读:deduction 做演绎(可删重复观察),
# induction 做归纳。触发条件:50 条观察 / 闲置 60 分钟,两次至少隔 8 小时。
# 频次低但单次最贵——每个 agent 最多 20 轮工具迭代、每轮读 16k 上下文,且无人值守。
# 建议先关:群记忆要的是 deriver 提炼的事实,dream 是二次归纳。
DREAM_ENABLED=false

# DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
# DREAM_DEDUCTION_MODEL_CONFIG__MODEL=your-flash-model-id
# DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
# DREAM_INDUCTION_MODEL_CONFIG__MODEL=your-flash-model-id

# peer_card 在当前版本没有独立的模型配置,只有开关:
# PEER_CARD_ENABLED=true

# =============================================================================
# 向量与 embedding
# =============================================================================
# embedding 是**硬依赖**,不是可选项:deriver 写 observation 前一律先算向量
# (src/utils/agent_tools.py create_observations),search_memory 等工具也无条件
# 把 query 向量化。没有可用的 embedding provider,记忆根本攒不起来。
#
# EMBED_MESSAGES 只管「聊天消息要不要算向量」这一路,与上面无关;关掉只损失
# 消息级语义检索,而且可以事后补:
#     python scripts/generate_message_embeddings.py --workspace-name <ws>
EMBED_MESSAGES=false

# embedding **不吃** LLM_OPENAI_BASE_URL,只认自己的 overrides.base_url。
# 所以只提供 chat-completions 的网关(如 opencode)必须在这里另配一家,
# 否则请求会打到 api.openai.com。
#
# 例:阿里云百炼 OpenAI 兼容模式 + text-embedding-v4。中文语境下它的召回通常
# 好于通用英文模型。base_url 用你自己的工作空间域名(控制台可查),区域段按开通
# 的地域替换(cn-beijing / ap-southeast-1 等)。
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-v4
# provider 对单批条数的上限。百炼 text-embedding-v4 是 10,不设的话 deriver 按自己的
# 默认批量发,服务端回 400 `batch size is invalid`,客户端再重试三轮——纯浪费。
# 换 provider 时按对方文档改;不确定就填 10,批小一点只是多几次往返。
EMBEDDING_MODEL_CONFIG__MAX_BATCH_SIZE=10
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://ws-<你的工作空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 下面两行是**一把 key**:前者填的是环境变量的名字(不是密钥),Honcho 据此去
# os.getenv 取值;后者才是密钥。变量名随便起,两处对上即可。也可以省成一行直接
# 写值:EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=sk-...
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_API_KEY=sk-dashscope-key

# 向量列宽取自这个值(src/models.py)。用 1536:alembic 建出来的默认 schema 就是
# vector(1536),不用迁移;text-embedding-v4 支持 dimensions 参数,会照这个值输出。
#
# 这一行不能省:dimensions_mode 默认 auto,只有**显式设过** VECTOR_DIMENSIONS 才会把
# dimensions= 发给服务端(src/config.py resolve_send_dimensions)。不发就用模型自己的
# 默认维度,与列宽对不上时启动被拒。
#
# 想用别的值(v4 可选 64/128/256/512/768/1024/1536/2048),建库后、起服务前跑一次:
#     uv run python scripts/configure_embeddings.py
EMBEDDING_VECTOR_DIMENSIONS=1536

VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false

# 换别家时不用管 encoding_format:默认 auto 只对 api.openai.com 用 base64,
# 其余 host 一律降到 float —— 第三方兼容实现常常不支持 base64。

# 其他 embedding 来源:
#   - OpenAI text-embedding-3-small:原生 1536,与默认 schema 对齐,用量小到可忽略
#   - Gemini:transport=gemini,客户端传 output_dimensionality,维度任选
#   - 本地服务(Infinity / TEI / Ollama):需要 OpenAI 兼容的 /v1/embeddings 端点;
#     FastEmbed 是库不是服务,要自己套一层
# 换 VECTOR_STORE_TYPE=lancedb 只改向量存哪儿,不解决「谁把文本变成向量」。
#
# ⚠️ 模型定了别轻易换:不同模型向量空间不通用,换了不会报错,只会静默地检索质量崩掉,
#    要换就得把已有 observation 全部重新 embed。
